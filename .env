# ============================================================
# EduStock — Variables de Entorno (Frontend)
# ============================================================
# IMPORTANTE: En Vite solo son accesibles las variables con
# prefijo VITE_. Usar como: import.meta.env.VITE_API_URL

# --- API Backend (NestJS) ---
VITE_API_URL=http://localhost:3000

# URL base construida: /api
VITE_API_BASE_URL=/api

# --- App ---
VITE_APP_NAME=EduStock
VITE_APP_ENV=development
